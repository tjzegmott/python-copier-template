# git-cliff configuration
# https://git-cliff.org/docs/configuration

[changelog]
header = """
# Changelog

All notable changes to this project will be documented in this file.
"""
body = """
{% raw %}{% if version -%}
## [{{ version | trim_start_matches(pat="v") }}] - {{ timestamp | date(format="%Y-%m-%d") }}
{% else -%}
## [Unreleased]
{% endif -%}
{% for group, commits in commits | group_by(attribute="group") %}
### {{ group | striptags | trim | upper_first }}
{% for commit in commits %}
- {% if commit.breaking %}[**breaking**] {% endif %}\
{% if commit.scope %}**{{ commit.scope }}:** {% endif %}\
{{ commit.message | upper_first }}\
{% endfor %}
{% endfor %}
{% endraw %}"""
footer = """
{% raw %}{% macro remote_url() %}https://github.com/OWNER/REPO{% endmacro %}
{% for release in releases -%}
    {% if release.version -%}
        {% if release.previous.version -%}
            [{{ release.version | trim_start_matches(pat="v") }}]: \
                {{ self::remote_url() }}/compare/{{ release.previous.version }}..{{ release.version }}
        {% endif -%}
    {% else -%}
        {% if release.previous.version -%}
            [unreleased]: {{ self::remote_url() }}/compare/{{ release.previous.version }}..HEAD
        {% endif -%}
    {% endif -%}
{% endfor %}
<!-- generated by git-cliff -->
{% endraw %}"""
trim = true
# Runs the rendered Markdown through a formatter; normalizes headings, list
# markers and blank lines so the template doesn't have to be pedantic about
# whitespace. Only applies to .md output or stdout.
format = true

[git]
conventional_commits = true
filter_unconventional = true
split_commits = false

# Order matters: the first matching parser wins.
#   1. skips first, so nothing below can resurrect them
#   2. security next, so it outranks the type-based groups
#   3. type-based groups last
commit_parsers = [
    # --- skips ---
    { footer = "^changelog: ?ignore", skip = true },
    { message = "^chore\\(release\\)", skip = true },
    # `^chore\(deps` (no closing paren) also catches chore(deps-dev) from Dependabot
    { message = "^chore\\(deps", skip = true },

    # --- security (must outrank feat/fix) ---
    # Remove the `message` line if you only want body mentions to count.
    { message = "(?i)security", group = "<!-- 2 -->Security" },
    { body = "(?i)security", group = "<!-- 2 -->Security" },

    # --- type groups ---
    # The `<!-- N -->` prefixes control section order; `striptags` in the body
    # template removes them from the rendered heading.
    { message = "^feat", group = "<!-- 0 -->Features" },
    { message = "^fix", group = "<!-- 1 -->Bug Fixes" },
    { message = "^perf", group = "<!-- 3 -->Performance" },
    { message = "^doc", group = "<!-- 4 -->Documentation" },
    { message = "^refactor", group = "<!-- 5 -->Refactor" },
    { message = "^style", group = "<!-- 6 -->Styling" },
    { message = "^test", group = "<!-- 7 -->Testing" },
    { message = "^revert", group = "<!-- 8 -->Revert" },
    { message = "^build", group = "<!-- 9 -->Build" },
    { message = "^chore|^ci", group = "<!-- 9 -->Miscellaneous Tasks" },
]

# Prevents a skip parser from ever swallowing a `feat!:` / `BREAKING CHANGE:`.
protect_breaking_commits = true

# Unmatched commits are dropped rather than silently rendering under an empty
# heading. Flip fail_on_unmatched_commit to true if you'd rather have the
# release fail loudly when someone invents a new commit type.
filter_commits = true
fail_on_unmatched_commit = false

topo_order = false
sort_commits = "oldest"

# Turns `#123` in messages/bodies into links available via `commit.links`.
# link_parsers = [
#     { pattern = "#(\\d+)", href = "https://github.com/OWNER/REPO/issues/$1" },
# ]
